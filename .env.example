# Supabase Backend Configuration
# 1. Create a project on https://supabase.com
# 2. Run the SQL in supabase-schema.sql inside your Supabase SQL Editor
# 3. Copy your project URL & anon key from Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Fallback REST API Base URL (used when Supabase is not configured)
VITE_API_BASE_URL=http://localhost:5000

# Razorpay Configuration
# Get these from https://dashboard.razorpay.com -> Settings -> API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Razorpay Subscription Plan IDs (optional for recurring billing)
VITE_RAZORPAY_PLAN_STARTER_MONTHLY=plan_xxxxxx
VITE_RAZORPAY_PLAN_STARTER_ANNUAL=plan_xxxxxx
VITE_RAZORPAY_PLAN_PRO_MONTHLY=plan_xxxxxx
VITE_RAZORPAY_PLAN_PRO_ANNUAL=plan_xxxxxx
VITE_RAZORPAY_PLAN_ENTERPRISE_MONTHLY=plan_xxxxxx
VITE_RAZORPAY_PLAN_ENTERPRISE_ANNUAL=plan_xxxxxx

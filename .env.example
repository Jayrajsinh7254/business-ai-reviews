# Supabase Backend Configuration
# 1. Create a project on https://supabase.com
# 2. Run the SQL in supabase-schema.sql inside your Supabase SQL Editor
# 3. Copy your project URL & anon key from Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Fallback REST API Base URL (used when Supabase is not configured)
VITE_API_BASE_URL=http://localhost:5000
